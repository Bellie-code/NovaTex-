@"
# Application
APP_NAME=NovaTex Privacy-Aware Face Recognition Attendance System
ENV=development

# PostgreSQL
DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Service
AI_SERVICE_URL=http://localhost:9000

# JWT Security
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_32_CHARS_MINIMUM
JWT_ALGORITHM=HS256

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
"@ | Set-Content backend/.env.example